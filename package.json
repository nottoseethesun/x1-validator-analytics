{
  "name": "x1-rewards-fetcher",
  "version": "1.0.0",
  "description": "A Node.js script to fetch inflation rewards for an X1 validator vote account, retrieve historical $XNT prices from a specified liquidity pool, and output a CSV spreadsheet with reward details and USD values.",
  "main": "bin/end-user/fetch-total-validator-earnings.js",
  "type": "module",
  "scripts": {
    "start": "node bin/end-user/fetch-total-validator-earnings.js",
    "api-keys": "node bin/end-user/manage-api-keys.js",
    "github-project-deps": "github-project-deps",
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0 && markdownlint-cli2 && npm run format:check && run-actionlint .github/workflows/*.yml && npm run knip:files",
    "lint:fix": "eslint . --fix && markdownlint-cli2 --fix && npm run format",
    "format": "prettier --write \"**/*.{js,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,yml,yaml}\"",
    "knip:files": "knip --include files",
    "test": "node --test --test-timeout=60000 \"test/*.test.js\"",
    "test:coverage": "node --test --test-timeout=60000 --experimental-test-coverage --test-coverage-lines=80 \"test/*.test.js\"",
    "audit:deps": "npm audit --audit-level=high --omit=dev && npm run audit:actionlint",
    "audit:actionlint": "run-actionlint --check",
    "audit:security": "eslint -c eslint-security.config.js . --max-warnings 0",
    "audit:secrets": "secretlint \"**/*\"",
    "check": "npm run lint && npm run test:coverage && npm run audit:deps && npm run audit:security && npm run audit:secrets"
  },
  "dependencies": {
    "@solana/web3.js": "^3.2.1",
    "commander": "^12.1.0",
    "crypto-price-fetchers": "github:nottoseethesun/crypto-price-fetchers#main",
    "csv-stringify": "^6.5.1",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "csv-parse": "^7.0.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "secretlint": "^11.7.1"
  },
  "author": "Chris M Balz using Grok to Generate",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
